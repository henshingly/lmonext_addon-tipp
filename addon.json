{
    "name": "tipp",
    "version": "1.5.0",
    "description": {
        "de": "Tippspiel-System mit Anmeldung, Tippabgabe, Auswertung und Joker-Regeln.",
        "en": "Betting game system with registration, tip submission, evaluation and joker rules."
    },
    "author": "Dietmar Kersting, Torsten Hofmann",
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/henshingly/addon-tipp",
    "min_core_version": "1.4.0",
    "type": "both",
    "admin_actions": [
        "tippspiel"
    ],
    "admin_nav": [
        {
            "action": "tippspiel",
            "icon": "🎯",
            "label_key": "nav_tippspiel",
            "position": 60
        }
    ],
    "frontend_routes": [
        "tippspiel"
    ],
    "admin_handlers": [
        "handler_tipp.php"
    ],
    "frontend_handlers": [
        "tipp_lib.php",
        "frontend_tipp.php",
        "hooks_frontend.php"
    ],
    "admin_views": [
        {
            "action": "tippspiel",
            "file": "view_tippspiel.php"
        }
    ],
    "frontend_views": [
        {
            "route": "tippspiel",
            "file": "view_tippspiel_page.php"
        }
    ],
    "templates_dir": "templates/",
    "lang_dir": "lang/",
    "hooks": [
        {
            "event": "liga.saved",
            "handler": "tippOnLigaSaved",
            "priority": 10
        }
    ],
    "dependencies": [],
    "db_tables": [
        "lmo_tipp_tipper",
        "lmo_tipp_tipps",
        "lmo_tipp_settings"
    ]
}